---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/fallback.png";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

// Social scrapers reject oversized images (X ~5MB, Facebook ~8MB), so serve a
// resized copy rather than the original asset. Never upscale past the source.
// webp keeps the alpha channel that fallback.png relies on.
const ogWidth = Math.min(1200, image.width);
const ogHeight = Math.round((ogWidth * image.height) / image.width);
const ogImage = await getImage({ src: image, width: ogWidth, format: "webp" });
const ogImageURL = new URL(ogImage.src, Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Google requires a square favicon that's a multiple of 48px, and probes /favicon.ico directly. -->
<link rel="icon" href="/favicon.ico" sizes="32x32 64x64" />
<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/favicon-192.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;700;900&family=IBM+Plex+Mono:wght@400;500;700&display=swap"
  rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={ogWidth} />
<meta property="og:image:height" content={ogHeight} />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />
<meta property="twitter:image:alt" content={title} />

<!-- GoatCounter Analytics -->
<script
  data-goatcounter="https://eidolware.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"></script>
