---
import { Image, getImage } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BlueskyFeed from "../components/BlueskyFeed.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import eidolwareLogo from "../assets/logos/eidolware_logo.png";
import annaSide from "../assets/characters/anna-side.png";
import susieSide from "../assets/characters/susie-side.png";
import allCharacters from "../assets/characters/eidolware-all-characters-web.png";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Logo silhouette used as a CSS mask for the RGB-split glitch layers
const logoMask = await getImage({ src: eidolwareLogo, width: 1200, format: "webp" });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="home-main">
      <section class="hero">
        <div class="hero-bg">
          <div class="hero-grid"></div>
          <div class="glow glow-pink"></div>
          <div class="glow glow-cyan"></div>
          <div class="scanlines"></div>
        </div>

        <Image
          src={allCharacters}
          alt=""
          width={2560}
          height={827}
          class="hero-characters"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />

        <div class="hero-inner">
          <div class="hero-top-bar">
            <span class="bar-label">FATBAT Studio //</span>
            <span class="bar-jp">ファットバット</span>
            <span class="bar-status"><span class="bar-slash">//</span> IN DEVELOPMENT</span>
          </div>

          <div class="hero-center">
            <h1 class="logo-wrap">
              <span
                class="logo-glitch"
                style={`--logo-mask: url(${logoMask.src})`}
              >
                <Image
                  src={eidolwareLogo}
                  alt="EIDOLWARE"
                  width={1200}
                  height={257}
                  class="logo"
                  loading="eager"
                  decoding="async"
                />
                <span class="glitch-layer glitch-pink" aria-hidden="true"></span>
                <span class="glitch-layer glitch-cyan" aria-hidden="true"></span>
              </span>
            </h1>
            <div class="tagline">
              <div class="tag-line"></div>
              <span class="tag-text">Cyberpunk Anime Convention Action-RPG</span
              >
              <div class="tag-line"></div>
            </div>
          </div>

          <p class="desc">{SITE_DESCRIPTION}</p>

          <div class="cta-row">
            <a
              href="https://fatbatstudio.itch.io/eidolware"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-pink">Follow on itch.io</a
            >
            <a href="#" class="btn btn-ghost" title="Coming Soon"
              >Steam — Coming Soon</a
            >
            <a href="/blog" class="btn btn-cyan">Devlog</a>
          </div>
        </div>

        <div class="hero-stripe">
          <div class="stripe-pink"></div>
          <div class="stripe-cyan"></div>
        </div>
      </section>

      <!-- Story -->
      <div class="story-banner">
        <div class="banner-art">
          <Image
            src={annaSide}
            alt="Anna Lam"
            width={800}
            height={300}
            class="banner-art-img"
            loading="lazy"
          />
        </div>
        <div class="banner-head">
          <div class="num-block num-pink">
            <span class="num">01</span>
          </div>
          <div class="head-text">
            <span class="head-jp">物語</span>
            <h2 class="head-title">The Story</h2>
          </div>
        </div>
      </div>

      <section class="story story-no-head">
        <div class="story-grid">
          <div class="story-card card-lead">
            <div class="card-edge edge-pink"></div>
            <p>
              Infiltrate a 24/7 anime convention where holograms are real,
              influencers reign supreme, and Otaku culture has gone completely
              off the rails in this satirical cyberpunk action-RPG by FATBAT
              Studio.
            </p>
          </div>
          <div class="story-card">
            <div class="card-edge edge-cyan"></div>
            <p>
              You are Anna Lam, a former AI engineer. The mysterious death of
              your mentor has led you to a newly established 24-hour anime
              convention, owned and operated by a crypto-billionaire who styles
              himself "Fedora Mask".
            </p>
          </div>
          <div class="story-card">
            <div class="card-edge edge-pink"></div>
            <p>
              Immerse yourself in the convention and meet its strange denizens.
              Team up with unlikely allies to defeat Fedora Mask's lieutenants
              and gain access to the convention's inner circle. Uncover the
              truth behind your mentor's death and if anyone is responsible, put
              an end to their plans.
            </p>
          </div>
        </div>
        <div class="story-stripe">
          <div class="stripe-pink"></div>
          <div class="stripe-cyan"></div>
        </div>
      </section>

      <!-- Features -->
      <div class="features-banner">
        <div class="banner-art">
          <Image
            src={susieSide}
            alt="Susie"
            width={800}
            height={300}
            class="banner-art-img"
            loading="lazy"
          />
        </div>
        <div class="banner-head">
          <div class="num-block num-cyan">
            <span class="num">02</span>
          </div>
          <div class="head-text">
            <span class="head-jp">フェドラコンが待つ</span>
            <h2 class="head-title">FedoraCon Awaits</h2>
          </div>
        </div>
      </div>

      <section class="features features-no-head">
        <div class="feature-grid">
          <div class="feature">
            <div class="card-edge edge-pink"></div>
            <div class="feature-idx">
              <span class="idx-num">A</span>
              <div class="idx-line"></div>
            </div>
            <h3>Underground Convention</h3>
            <p>
              Enter FedoraCon, a 24/7 anime convention in an underground bunker,
              powered by holographic technology and funded by a
              crypto-billionaire's dream of making anime real.
            </p>
          </div>
          <div class="feature">
            <div class="card-edge edge-cyan"></div>
            <div class="feature-idx">
              <span class="idx-num">B</span>
              <div class="idx-line"></div>
            </div>
            <h3>Distinct Wings</h3>
            <p>
              Explore themed convention wings: an artist alley that turns into a
              haunted forest, a ballroom dance-off maze, a cosplay battle
              royale, and secret areas, each run by a lieutenant with their own
              rules.
            </p>
          </div>
          <div class="feature">
            <div class="card-edge edge-pink"></div>
            <div class="feature-idx">
              <span class="idx-num">C</span>
              <div class="idx-line"></div>
            </div>
            <h3>Eccentric Cast</h3>
            <p>
              A Halloween obsessive lifestylist, a K-Pop star who only speaks
              through dance, a corporate-sponsored kawaii influencer, a
              conspirophile vinyl figure collector, and a masked billionaire who
              thinks he's a Level 20 Paladin.
            </p>
          </div>
          <div class="feature">
            <div class="card-edge edge-cyan"></div>
            <div class="feature-idx">
              <span class="idx-num">D</span>
              <div class="idx-line"></div>
            </div>
            <h3>Aggressive Combat</h3>
            <p>
              Fast-paced action-RPG combat that rewards aggression over caution,
              with unique encounters, enemies you can weaponize against each
              other, and wacky boss fights you won't see coming.
            </p>
          </div>
          <div class="feature">
            <div class="card-edge edge-pink"></div>
            <div class="feature-idx">
              <span class="idx-num">E</span>
              <div class="idx-line"></div>
            </div>
            <h3>PROXY System</h3>
            <p>
              Summon allies to aid you mid-combat, then mix and match multiple
              summons to combine their abilities into devastating new team
              attacks.
            </p>
          </div>
          <div class="feature">
            <div class="card-edge edge-cyan"></div>
            <div class="feature-idx">
              <span class="idx-num">F</span>
              <div class="idx-line"></div>
            </div>
            <h3>Voice &amp; Sound</h3>
            <p>
              Fully voiced by seasoned professionals with credits in anime,
              games, animation, and theater, plus talented newcomers, backed by
              an original soundtrack from <a
                href="https://www.debiscomusic.com/"
                target="_blank"
                rel="noopener noreferrer">DeBisco</a
              > and other great music artists, NOT AI.
            </p>
          </div>
        </div>
      </section>

      <BlueskyFeed />

      {
        posts.length > 0 && (
          <section class="devlog">
            <div class="section-head">
              <div class="num-block num-pink">
                <span class="num">04</span>
              </div>
              <div class="head-text">
                <span class="head-jp">開発日記</span>
                <h2 class="head-title">Devlog</h2>
              </div>
              <div class="head-rule" />
              <a href="/blog" class="devlog-all">
                All Posts →
              </a>
            </div>
            <div class="devlog-grid">
              {posts.map((post, i) => (
                <article class="devlog-card">
                  <a href={`/blog/${post.id}/`} class="devlog-link">
                    <div
                      class="card-top-stripe"
                      style={`background: ${i % 2 === 0 ? "#e8157a" : "#00e5c3"}`}
                    />
                    {post.data.heroImage && (
                      <div class="devlog-thumb">
                        <Image
                          src={post.data.heroImage}
                          alt=""
                          width={600}
                          class="devlog-thumb-img"
                          loading="lazy"
                          style={post.data.heroImagePosition ? `object-position: ${post.data.heroImagePosition}` : undefined}
                        />
                      </div>
                    )}
                    <time>
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </main>
    <Footer />

    <script>
      // Replay the intro glitch on click by rewinding its CSS animations
      const INTRO = ["glitchMain", "glitchPink", "glitchCyan", "glitchTear"];
      const INTRO_DELAY_MS = 400;
      const logoGlitch = document.querySelector<HTMLElement>(".logo-glitch");

      // Grab the intro animations now: once finished, getAnimations() drops them
      const intro = (logoGlitch?.getAnimations({ subtree: true }) ?? []).filter(
        (a): a is CSSAnimation =>
          a instanceof CSSAnimation && INTRO.includes(a.animationName),
      );

      logoGlitch?.addEventListener("click", () => {
        // Wait for the intro (or a previous replay) to finish
        if (!intro.length || intro.some((a) => a.playState !== "finished")) return;
        for (const a of intro) {
          a.currentTime = INTRO_DELAY_MS;
          a.play();
        }
      });
    </script>
  </body>
</html>

<style>
  .home-main {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  /* ═══ HERO ═══ */
  .hero {
    position: relative;
    width: 100%;
    padding: 3rem 3rem 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(232, 21, 122, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232, 21, 122, 0.06) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(
      ellipse 80% 70% at 50% 40%,
      black 20%,
      transparent 70%
    );
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
  }

  .glow-pink {
    width: 600px;
    height: 600px;
    background: #e8157a;
    top: -30%;
    left: 10%;
  }

  .glow-cyan {
    width: 450px;
    height: 450px;
    background: #00e5c3;
    bottom: -20%;
    right: 5%;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.008) 2px,
      rgba(255, 255, 255, 0.008) 4px
    );
    pointer-events: none;
  }

  /* Character lineup: bleeds wider than the 1400px content column, but
     capped below the width where it would outgrow the hero and clip;
     bottom flush with the pink/cyan stripe */
  .hero-characters {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 3px;
    width: 100%;
    max-width: 1800px;
    height: auto;
    z-index: 0;
    opacity: 0.18;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 3rem;
  }

  .hero-top-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid #1a1a28;
    width: fit-content;
  }

  .bar-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #e8157a;
  }

  .bar-jp {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #00e5c3;
    letter-spacing: 0.15em;
  }

  .bar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8585a0;
  }

  .bar-slash {
    color: #00e5c3;
    margin-right: 0.25em;
  }

  .hero-center {
    margin-bottom: 2rem;
  }

  .logo-wrap {
    margin: 0 0 1.5rem;
    display: flex;
    justify-content: center;
    animation: scaleIn 0.6s ease-out 0.4s backwards;
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .logo-glitch {
    position: relative;
    display: block;
    width: 100%;
    max-width: 900px;
    line-height: 0;
  }

  .logo {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(1.4) contrast(1.1) saturate(0.9)
      drop-shadow(0 0 8px rgba(0, 229, 195, 0.25))
      drop-shadow(0 0 15px rgba(232, 21, 122, 0.15));
    transition: filter 0.3s ease;
    animation:
      glitchMain 0.9s steps(1, end) 0.4s backwards,
      glowPulse 4s ease-in-out 1s infinite;
  }

  /* ---- Glitch-in: sliced, jittering logo with pink/cyan RGB split ---- */
  .glitch-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    -webkit-mask: var(--logo-mask) center / 100% 100% no-repeat;
    mask: var(--logo-mask) center / 100% 100% no-repeat;
  }

  .glitch-pink {
    background: #e8157a;
    animation:
      glitchIdlePink 7s steps(1, end) 3s infinite,
      glitchPink 0.9s steps(1, end) 0.4s backwards;
  }

  .glitch-cyan {
    background: #00e5c3;
    animation:
      glitchIdleCyan 7s steps(1, end) 3s infinite,
      glitchCyan 0.9s steps(1, end) 0.4s backwards;
  }

  /* Wide scan-tear line that flickers across the logo during the intro */
  .logo-glitch::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    height: 3px;
    top: 50%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      #00e5c3 20%,
      #fff 50%,
      #e8157a 80%,
      transparent
    );
    box-shadow: 0 0 12px rgba(0, 229, 195, 0.6);
    animation: glitchTear 0.9s steps(1, end) 0.4s backwards;
  }

  @keyframes glitchMain {
    0% { clip-path: inset(40% 0 45% 0); transform: translateX(-24px); opacity: 1; }
    7% { clip-path: inset(0 0 70% 0); transform: translateX(18px); }
    13% { clip-path: inset(78% 0 0 0); transform: translateX(-10px); }
    19% { opacity: 0; }
    25% { clip-path: inset(18% 0 48% 0); transform: translateX(28px) skewX(-12deg); opacity: 1; }
    32% { clip-path: inset(0); transform: translateX(-5px); }
    39% { clip-path: inset(55% 0 12% 0); transform: translateX(12px); }
    46% { clip-path: inset(0); transform: none; opacity: 0.35; }
    52% { clip-path: inset(8% 0 76% 0); transform: translateX(-32px); opacity: 1; }
    60% { clip-path: inset(0); transform: translateX(4px); }
    70% { clip-path: inset(64% 0 22% 0); transform: translateX(-7px); }
    78% { clip-path: inset(0); transform: translateX(2px) skewX(3deg); }
    86%, 100% { clip-path: inset(0); transform: none; opacity: 1; }
  }

  @keyframes glitchPink {
    0% { opacity: 0.9; clip-path: inset(10% 0 60% 0); transform: translate(-30px, -2px); }
    9% { clip-path: inset(62% 0 8% 0); transform: translate(22px, 1px); }
    18% { clip-path: inset(30% 0 40% 0); transform: translate(-14px, 0); }
    27% { opacity: 0; }
    34% { opacity: 0.9; clip-path: inset(0 0 55% 0); transform: translate(-40px, 2px) skewX(10deg); }
    44% { clip-path: inset(70% 0 0 0); transform: translate(10px, 0); }
    54% { clip-path: inset(0); transform: translate(-6px, 0); opacity: 0.7; }
    64% { clip-path: inset(45% 0 35% 0); transform: translate(-18px, 0); opacity: 0.9; }
    76% { clip-path: inset(0); transform: translate(-3px, 0); opacity: 0.5; }
    88%, 100% { opacity: 0; clip-path: inset(0); transform: none; }
  }

  @keyframes glitchCyan {
    0% { opacity: 0.9; clip-path: inset(50% 0 20% 0); transform: translate(28px, 2px); }
    9% { clip-path: inset(5% 0 72% 0); transform: translate(-20px, -1px); }
    18% { clip-path: inset(72% 0 6% 0); transform: translate(16px, 0); }
    27% { opacity: 0; }
    34% { opacity: 0.9; clip-path: inset(40% 0 0 0); transform: translate(38px, -2px) skewX(-10deg); }
    44% { clip-path: inset(0 0 66% 0); transform: translate(-12px, 0); }
    54% { clip-path: inset(0); transform: translate(6px, 0); opacity: 0.7; }
    64% { clip-path: inset(15% 0 62% 0); transform: translate(20px, 0); opacity: 0.9; }
    76% { clip-path: inset(0); transform: translate(3px, 0); opacity: 0.5; }
    88%, 100% { opacity: 0; clip-path: inset(0); transform: none; }
  }

  /* Brief periodic flicker after the intro, idle ~96% of the cycle */
  @keyframes glitchIdlePink {
    0% { opacity: 0.8; clip-path: inset(22% 0 58% 0); transform: translateX(-14px); }
    1% { clip-path: inset(66% 0 14% 0); transform: translateX(9px); }
    2% { clip-path: inset(0); transform: translateX(-3px); opacity: 0.5; }
    3%, 100% { opacity: 0; clip-path: inset(0); transform: none; }
  }

  @keyframes glitchIdleCyan {
    0% { opacity: 0.8; clip-path: inset(60% 0 20% 0); transform: translateX(14px); }
    1% { clip-path: inset(12% 0 70% 0); transform: translateX(-9px); }
    2% { clip-path: inset(0); transform: translateX(3px); opacity: 0.5; }
    3%, 100% { opacity: 0; clip-path: inset(0); transform: none; }
  }

  @keyframes glitchTear {
    0% { opacity: 1; top: 48%; transform: translateX(-6%); }
    10% { top: 22%; transform: translateX(4%); }
    20% { opacity: 0; }
    30% { opacity: 1; top: 70%; transform: translateX(-3%); height: 2px; }
    42% { top: 35%; transform: translateX(6%); height: 5px; }
    54% { opacity: 0; }
    64% { opacity: 0.8; top: 84%; transform: none; height: 2px; }
    74%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo {
      animation: none;
    }

    .glitch-layer,
    .logo-glitch::after {
      display: none;
    }
  }

  @keyframes glowPulse {
    0%,
    100% {
      filter: brightness(1.4) contrast(1.1) saturate(0.9)
        drop-shadow(0 0 8px rgba(0, 229, 195, 0.25))
        drop-shadow(0 0 15px rgba(232, 21, 122, 0.15));
    }
    50% {
      filter: brightness(1.5) contrast(1.12) saturate(0.95)
        drop-shadow(0 0 12px rgba(0, 229, 195, 0.4))
        drop-shadow(0 0 22px rgba(232, 21, 122, 0.25));
    }
  }

  .logo:hover {
    filter: brightness(1.8) contrast(1.2) saturate(1.1)
      drop-shadow(0 0 15px rgba(0, 229, 195, 0.4))
      drop-shadow(0 0 25px rgba(232, 21, 122, 0.25));
  }

  .tagline {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: center;
  }

  .tag-line {
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, #e8157a);
  }

  .tag-line:last-child {
    background: linear-gradient(90deg, #00e5c3, transparent);
  }

  .tag-text {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #9090a0;
  }

  .desc {
    font-family: "IBM Plex Mono", monospace;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #a0a0a8;
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    padding: 0.875rem 2rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: all 0.15s ease;
    border: 2px solid;
  }

  .btn-pink {
    background: #e8157a;
    border-color: #e8157a;
    color: #fff;
  }

  .btn-pink:hover {
    background: #ff2090;
    border-color: #ff2090;
    box-shadow: 0 0 30px rgba(232, 21, 122, 0.4);
    color: #fff;
  }

  .btn-ghost {
    background: transparent;
    border-color: #333;
    color: #8585a0;
  }

